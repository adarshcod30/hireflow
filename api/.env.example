# Local development. Copy to .env. Nothing here is a real secret.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hireflow:hireflow-local-only@localhost:5432/hireflow_dev
DATABASE_SSL=false

# Leave empty in development to get random per-process secrets.
# In production both are required, 32+ characters, and different from each other.
JWT_SECRET=
INTERNAL_HMAC_SECRET=

WEB_ORIGINS=http://localhost:5173

# local = files on disk and fake upload URLs, s3 = real S3
STORAGE_DRIVER=local
# memory = in-process queue, sqs = real SQS
QUEUE_DRIVER=memory
AWS_REGION=ap-south-1
RESUME_BUCKET=
NOTIFICATIONS_QUEUE_URL=

OUTBOX_RELAY_ENABLED=true
LOG_LEVEL=info
